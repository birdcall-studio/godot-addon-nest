#!/usr/bin/env bash
# semantic-release runs this while making an add-on release, from the add-on's
# .releaserc.json. It writes the version into plugin.cfg, then zips the add-on
# with nest-package.
#   nest-release-prepare <version>
set -euo pipefail

version="${1:?usage: nest-release-prepare <version>}"
shopt -s nullglob
cfgs=(addons/*/plugin.cfg)
if (( ${#cfgs[@]} != 1 )); then
    echo "expected exactly one addons/<name>/plugin.cfg, found ${#cfgs[@]}" >&2
    exit 1
fi
cfg="${cfgs[0]}"

if ! grep -q '^version="' "$cfg"; then
    echo "$cfg: no version= line to update" >&2
    exit 1
fi
sed -i "s/^version=\".*\"/version=\"$version\"/" "$cfg"

"$(dirname "$0")/nest-package" "$version"
echo "prepared $(basename "$(dirname "$cfg")") $version: $cfg"
