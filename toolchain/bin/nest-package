#!/usr/bin/env bash
# Build dist/<name>-v<version>.zip from the add-on folder, with LICENSE
# inside. Releases attach this zip. It only needs bash, git and zip, so it runs
# on a bare CI runner.
#   nest-package            use the version in plugin.cfg
#   nest-package <version>  name the zip for that version
set -euo pipefail

shopt -s nullglob
cfgs=(addons/*/plugin.cfg)
if (( ${#cfgs[@]} != 1 )); then
    echo "expected exactly one addons/<name>/plugin.cfg, found ${#cfgs[@]}" >&2
    exit 1
fi
cfg="${cfgs[0]}"
dir="$(dirname "$cfg")"
name="$(basename "$dir")"
version="${1:-$(sed -n 's/^version="\(.*\)"/\1/p' "$cfg")}"
if [[ -z "$version" ]]; then
    echo "$cfg: no version=\"...\" line" >&2
    exit 1
fi

# Games copy only addons/<name>/, so the license goes inside it.
stage="$(mktemp -d)"
trap 'rm -rf "$stage"' EXIT
if git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    # Skip ignored files so a local zip matches a release, which is built from
    # a clean checkout. New files you haven't committed are still zipped here,
    # but a release won't have them.
    git ls-files -z -co --exclude-standard -- "$dir" > "$stage/files"
    while IFS= read -r -d '' file; do
        # A tracked file deleted but not yet committed is listed too.
        if [[ -e "$file" || -L "$file" ]]; then
            cp -P --parents -- "$file" "$stage/"
        fi
    done < "$stage/files"
else
    mkdir -p "$stage/addons"
    cp -r "$dir" "$stage/addons/"
fi
[[ -f "$stage/addons/$name/LICENSE" ]] || cp LICENSE "$stage/addons/$name/LICENSE"
# Clear dist/ first so it only holds the zip we just built.
rm -rf dist
mkdir dist
(cd "$stage" && zip -qr - addons) > "dist/$name-v$version.zip"
echo "packaged dist/$name-v$version.zip"
