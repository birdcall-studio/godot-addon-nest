# Style rules for every file. Editors such as VS Code follow this file, and
# `make lint` (editorconfig-checker) enforces it. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# GDScript, following Godot's official style guide.
[*.gd]
indent_style = tab
indent_size = 4
tab_width = 4
max_line_length = 100

# Shaders, as the Godot editor writes them.
[*.{gdshader,gdshaderinc}]
indent_style = tab
indent_size = 4
tab_width = 4

[*.sh]
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab
indent_size = 4
tab_width = 4

# Markdown indent depends on lists and code blocks, so markdownlint checks it
# instead.
[*.md]
indent_style = unset
indent_size = unset
# Two trailing spaces make a line break in Markdown. markdownlint (MD009)
# checks them.
trim_trailing_whitespace = unset
